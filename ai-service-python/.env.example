# Copier ce fichier en .env et renseigner la clé (le .env est ignoré par git).
# Clé API Mistral, à créer sur https://console.mistral.ai
# Laissée vide ou absente : le service renvoie une réponse simulée.
MISTRAL_API_KEY=votre_cle_mistral

# Modèle utilisé (optionnel). Si Mistral répond 429 « Rate limit exceeded » avec
# mistral-small-latest (limite à 0 sur certains comptes), essayer open-mistral-nemo.
MISTRAL_MODEL=mistral-small-latest

# Dossier de la base vectorielle ChromaDB (optionnel).
# Défaut : le dossier chroma_db à côté du code, généré par « python build_vector_db.py ».
# CHROMA_DB_PATH=/chemin/vers/chroma_db

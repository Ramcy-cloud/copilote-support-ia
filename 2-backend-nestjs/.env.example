# NestJS ne charge pas ce fichier automatiquement : définissez ces variables
# dans l'environnement du shell avant `npm run start:dev`.

# Origines autorisées à appeler l'API depuis un navigateur (CORS), séparées par des virgules.
# Défaut : http://localhost:5173 (frontend en local). Le joker "*" est ignoré.
ALLOWED_ORIGINS=http://localhost:5173

# URL complète de la route du service IA Python (appel de serveur à serveur).
AI_SERVICE_URL=http://localhost:8000/ask-copilot

# Port d'écoute de l'orchestrateur (optionnel, 3000 par défaut).
PORT=3000

# Synchronisation automatique du schéma TypeORM (optionnel, false par défaut).
# ATTENTION : à n'activer qu'en développement. TypeORM aligne alors les tables sur les
# entités à chaque démarrage et peut supprimer des colonnes, donc des données.
# Utile au premier lancement pour créer la table tickets_historique dans database.sqlite.
DB_SYNCHRONIZE=false

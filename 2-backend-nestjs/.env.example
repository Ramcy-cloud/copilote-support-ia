# NestJS ne charge pas ce fichier automatiquement : définissez ces variables
# dans l'environnement du shell avant `npm run start:dev`.

# Origines autorisées à appeler l'API depuis un navigateur (CORS), séparées par des virgules.
# Défaut : http://localhost:5173 (frontend en local). Le joker "*" est ignoré.
ALLOWED_ORIGINS=http://localhost:5173

# URL complète de la route du service IA Python (appel de serveur à serveur).
AI_SERVICE_URL=http://localhost:8000/ask-copilot

# Port d'écoute de l'orchestrateur (optionnel, 3000 par défaut).
PORT=3000

# Limitation du débit sur /copilot, par adresse IP (optionnel) : 20 requêtes par minute par défaut.
# Protège le quota du LLM ; au-delà, l'API répond 429.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# Chemin de la base SQLite (optionnel, database.sqlite par défaut). Les tests utilisent :memory:.
# DB_PATH=database.sqlite

# Synchronisation automatique du schéma TypeORM (optionnel, false par défaut).
# ATTENTION : à n'activer qu'en développement. TypeORM aligne alors les tables sur les
# entités à chaque démarrage et peut supprimer des colonnes, donc des données.
# La table tickets_historique est déjà créée par une migration : inutile pour le premier lancement.
DB_SYNCHRONIZE=false

# --- Authentification (OBLIGATOIRE) ---------------------------------------
# Clé de signature des jetons JWT. L'application REFUSE de démarrer si elle est
# absente ou fait moins de 32 caractères : un secret faible rend tous les jetons
# forgeables. Ne jamais versionner la valeur réelle, ni la réutiliser entre
# environnements. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Durée de validité d'un jeton (optionnel, 1h par défaut). Format jsonwebtoken :
# 15m, 1h, 7d... Plus la durée est courte, plus un jeton volé expire vite.
JWT_EXPIRES_IN=1h

# Limitation des tentatives de connexion, par adresse IP (optionnel).
# Défaut : 5 tentatives par 15 minutes. Protège les mots de passe de la force
# brute ; compteur distinct de RATE_LIMIT_MAX, qui protège le quota du LLM.
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
